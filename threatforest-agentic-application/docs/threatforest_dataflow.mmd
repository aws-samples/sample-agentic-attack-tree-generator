    classDef inputClass fill:#f5f5f5,stroke:#666,stroke-width:2px,color:#333
    classDef processClass fill:#e8e8e8,stroke:#444,stroke-width:2px,color:#333
    classDef standardClass fill:#ffe6cc,stroke:#d79b00,stroke-width:3px,color:#333
    classDef outputClass fill:#d5e8d4,stroke:#82b366,stroke-width:2px,color:#333
    classDef formatClass fill:#f8cecc,stroke:#b85450,stroke-width:1px,stroke-dasharray: 5 5,color:#333
    
    class TCJson,FormattedMD,UnformattedMD,Images,Docs inputClass
    class FileDetection,JQParser,DirectExtract,BedrockReformat,BedrockVision,ProjectAnalysis,ThreatPrioritization processClass
    class Standardizer standardClass
    class StandardOutput outputClass
    class Raw,Parsed,Standard,Enriched formatClass
