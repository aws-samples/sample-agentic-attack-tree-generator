# ThreatForest Environment Variables
# Copy this file to .env and fill in your credentials

# ================================
# AWS Bedrock (Active by default)
# ================================
# Option 1: Use AWS Profile (recommended)
AWS_PROFILE=team-prod
AWS_REGION=us-east-1

# Option 2: Use Access Keys directly (comment out profile above)
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here
# AWS_SESSION_TOKEN=your_session_token_here  # If using temporary credentials
# AWS_REGION=us-east-1


# ================================
# Anthropic Direct API
# ================================
# Uncomment if using Anthropic provider in config.yaml
# Get your key from: https://console.anthropic.com/

# ANTHROPIC_API_KEY=sk-ant-your-key-here


# ================================
# OpenAI
# ================================
# Uncomment if using OpenAI provider in config.yaml
# Get your key from: https://platform.openai.com/api-keys

# OPENAI_API_KEY=sk-your-key-here


# ================================
# Google Gemini
# ================================
# Uncomment if using Gemini provider in config.yaml
# Get your key from: https://makersuite.google.com/app/apikey

# GEMINI_API_KEY=your-gemini-key-here


# ================================
# LiteLLM
# ================================
# Uncomment if using LiteLLM provider in config.yaml
# LiteLLM acts as a proxy to multiple providers

# LITELLM_API_KEY=your-litellm-key-here


# ================================
# LlamaAPI
# ================================
# Uncomment if using LlamaAPI provider in config.yaml
# Get your key from: https://www.llama-api.com/

# LLAMAAPI_API_KEY=your-llamaapi-key-here


# ================================
# Ollama (Local)
# ================================
# No API key needed - runs locally
# Install from: https://ollama.ai/
# Configure host in config.yaml if not using default localhost:11434


# ================================
# AWS SageMaker
# ================================
# Uses same AWS credentials as Bedrock
# Requires a deployed SageMaker endpoint

# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here
