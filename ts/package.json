{
  "name": "@threatforest/workspace",
  "private": true,
  "version": "0.0.0",
  "description": "ThreatForest TypeScript migration workspace (engine, server, cli, web).",
  "workspaces": [
    "packages/*",
    "web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:packages": "npm run build -w @threatforest/types && tsc -b packages/engine packages/server packages/cli packages/mcp-server",
    "build:web": "npm run build -w @threatforest/web",
    "build": "npm run build:packages && npm run build:web",
    "dev:ml": "cd .. && ${TF_PYTHON:-.venv/bin/python} -m ml_service",
    "dev:server": "node --import tsx/esm packages/server/src/main.ts",
    "dev:web": "npm run dev -w @threatforest/web",
    "dev": "concurrently -n ml,server,web -c magenta,blue,green \"npm:dev:ml\" \"npm:dev:server\" \"npm:dev:web\"",
    "start": "npm run build && npm run start -w @threatforest/server",
    "typecheck": "tsc -b --pretty",
    "test": "node --import tsx/esm --test \"packages/engine/src/**/*.test.ts\"",
    "spike": "node --import tsx/esm packages/spike/src/run-all.ts",
    "spike:interrupt": "node --import tsx/esm packages/spike/src/graph-interrupt.ts",
    "spike:structured": "node --import tsx/esm packages/spike/src/structured-output.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
