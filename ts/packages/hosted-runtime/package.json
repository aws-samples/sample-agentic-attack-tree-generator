{
  "name": "@threatforest/hosted-runtime",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "AgentCore HTTP runtime and durable boundary executor for hosted ThreatForest runs.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./report-archive": {
      "types": "./dist/src/report-archive.d.ts",
      "default": "./dist/src/report-archive.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/src/entrypoint.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "TSX_TSCONFIG_PATH=tsconfig.check.json node --import tsx/esm --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "^3.1113.0",
    "@aws-sdk/client-dynamodb": "^3.1087.0",
    "@aws-sdk/client-kms": "^3.1087.0",
    "@aws-sdk/client-s3": "^3.1087.0",
    "@aws-sdk/client-secrets-manager": "^3.1087.0",
    "@aws-sdk/lib-dynamodb": "^3.1087.0",
    "@aws/aws-distro-opentelemetry-node-autoinstrumentation": "^0.12.0",
    "@opentelemetry/api": "^1.9.1",
    "@threatforest/control-plane": "*",
    "@threatforest/engine": "*",
    "@threatforest/types": "*",
    "aws-jwt-verify": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
