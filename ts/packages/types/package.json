{
  "name": "@threatforest/types",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Shared Zod schemas + inferred TypeScript types for ThreatForest (engine, server, UI). Source of truth, mirroring the legacy Python Pydantic/dataclass models.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx/esm --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
