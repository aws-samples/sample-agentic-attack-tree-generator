{
  "name": "@threatforest/hosted-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Hosted HTTP, WebSocket, upload, and MCP compatibility layer for ThreatForest.",
  "exports": {
    ".": "./src/index.ts",
    "./lambda/http": "./src/lambda/http.ts",
    "./lambda/websocket": "./src/lambda/websocket.ts"
