    "@aws-sdk/client-dynamodb": "^3.1087.0",
    "@aws-sdk/client-s3": "^3.1087.0",
    "@aws-sdk/client-secrets-manager": "^3.1087.0",
    "@aws-sdk/client-sqs": "^3.1087.0",
    "@aws-sdk/lib-dynamodb": "^3.1087.0",
    "@aws-sdk/s3-request-presigner": "^3.1087.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@threatforest/control-plane": "*",
    "@threatforest/hosted-runtime": "*",
    "@threatforest/ingestion": "*",
    "@threatforest/types": "*"
