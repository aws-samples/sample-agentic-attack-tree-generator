# Include documentation and configuration files
include README.md
include TROUBLESHOOTING.md
include LICENSE
include pyproject.toml
include requirements-dev.txt
include pytest.ini

# Include configuration templates
recursive-include threatforest/templates *.yaml *.json *.md

# Include example projects
recursive-include examples *.md *.yaml *.json *.mmd *.png *.svg

# Include documentation
recursive-include docs *.md *.rst

# Include test fixtures
recursive-include tests/fixtures *.yaml *.json *.md

# Include scripts
recursive-include scripts *.py *.md

# Exclude development and build artifacts
global-exclude *.pyc
global-exclude *.pyo
global-exclude *.pyd
global-exclude __pycache__
global-exclude .pytest_cache
global-exclude *.egg-info
global-exclude .git*
global-exclude venv
global-exclude .venv
global-exclude .kiro
global-exclude tf-output