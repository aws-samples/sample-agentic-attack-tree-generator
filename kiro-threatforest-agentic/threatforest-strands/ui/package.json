{
  "name": "threatforest-ui",
  "version": "1.0.0",
  "description": "React Ink terminal UI for ThreatForest",
  "main": "dist/index.js",
  "bin": {
    "threatforest": "./dist/cli.js"
  },
  "scripts": {
    "build": "esbuild src/index.tsx --bundle --platform=node --outfile=dist/index.js --external:ink --external:react --format=cjs",
    "build:cli": "esbuild src/cli.tsx --bundle --platform=node --outfile=dist/cli.js --external:ink --external:react --format=cjs --banner:js=\"#!/usr/bin/env node\" && chmod +x dist/cli.js",
    "build:all": "npm run build && npm run build:cli",
    "dev": "npm run build:cli && node dist/cli.js",
    "watch": "esbuild src/index.tsx --bundle --platform=node --outfile=dist/index.js --external:ink --external:react --format=cjs --watch",
    "install:global": "npm run build:all && npm link"
  },
  "dependencies": {
    "ink": "^4.4.1",
    "react": "^18.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^5.0.1",
    "ink-select-input": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "esbuild": "^0.19.0",
    "typescript": "^5.3.0"
  }
}
